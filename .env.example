# Server-only PostgreSQL connection URI.
# Copy the Transaction pooler URI from Supabase Dashboard > Connect.
# Never prefix this with VITE_ and never expose it to the browser.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Protects /api/cron/check-quakes. Use a long random value.
CRON_SECRET=replace-with-a-long-random-secret

# Firebase Admin SDK (server-side only)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nREPLACE_ME\\n-----END PRIVATE KEY-----\\n"

# Firebase Web App configuration (public browser configuration)
VITE_FIREBASE_CONFIG={}
VITE_FIREBASE_VAPID_KEY=
